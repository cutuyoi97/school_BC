{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/identidad", "destination": "/pages/identidad.html" },
    { "source": "/docentes", "destination": "/pages/docentes.html" },
    { "source": "/eventos", "destination": "/pages/eventos.html" },
    { "source": "/academica", "destination": "/pages/academica.html" },
    { "source": "/contacto", "destination": "/pages/contacto.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/pages/identidad.html", "destination": "/identidad", "statusCode": 301 },
    { "source": "/pages/docentes.html", "destination": "/docentes", "statusCode": 301 },
    { "source": "/pages/eventos.html", "destination": "/eventos", "statusCode": 301 },
    { "source": "/pages/academica.html", "destination": "/academica", "statusCode": 301 },
    { "source": "/pages/contacto.html", "destination": "/contacto", "statusCode": 301 },
    { "source": "/pages/:page(identidad|docentes|eventos|academica|contacto)", "destination": "/:page", "statusCode": 301 },
    { "source": "/centros-de-interes", "destination": "/eventos#centros-interes", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
