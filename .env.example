# Copia este archivo como .env.local para desarrollo local con `vercel dev`.
# En producción, configura estas mismas variables en Vercel:
# Project Settings > Environment Variables.
# Nunca subas un archivo .env con valores reales al repositorio.
#
# Las tres primeras son OBLIGATORIAS: si falta alguna, /api/contact responde
# 503 y no envía nada (no hay remitente ni destinatario por defecto).

# API key de Resend (Dashboard > API Keys).
RESEND_API_KEY=

# Dirección que recibe los mensajes del formulario de contacto.
# Pendiente: la institución debe indicar el correo oficial.
CONTACT_TO_EMAIL=

# Remitente que aparecerá en el correo. Debe pertenecer a un dominio
# verificado en Resend (Dashboard > Domains). El remitente de pruebas
# onboarding@resend.dev solo entrega al dueño de la cuenta de Resend.
CONTACT_FROM_EMAIL=

# Opcional: orígenes adicionales autorizados a usar el formulario, separados
# por comas (p. ej. http://localhost:3000 para `vercel dev`). Los dominios de
# producción y la URL del despliegue de vista previa ya están permitidos.
ALLOWED_ORIGINS=
